---
// The landing's sections, as BeamNG's documentation lays out its home: a card
// per audience, its links in small labelled groups.
type Link = { href: string; text: string };
type Group = { label: string; links: Link[] };
type Section = { title: string; lede: string; groups: Group[] };
const { sections } = Astro.props as { sections: Section[] };
---

<div class="nmp-grid not-content">
  {sections.map((s) => (
    <section class="nmp-card">
      <h2>{s.title}</h2>
      <p class="nmp-lede">{s.lede}</p>
      {s.groups.map((g) => (
        <div class="nmp-group">
          <p class="nmp-label">{g.label}</p>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.text}</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9.5 6 15.5 12 9.5 18" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</div>

<style>
  .nmp-grid {
    display: grid;
    gap: 12px;
    margin-top: 2rem;
  }

  @media (min-width: 50rem) {
    .nmp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .nmp-card {
    padding: 24px;
    border-radius: 18px;
    background: var(--nmp-card);
  }

  h2 {
    margin: 0;
    font-family: var(--nmp-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--nmp-fg);
  }

  .nmp-lede {
    margin: 0.5rem 0 0;
    color: var(--nmp-fg-soft);
    font-size: 15px;
  }

  .nmp-group {
    margin-top: 1.25rem;
  }

  .nmp-label {
    margin: 0 0 0.4rem;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--nmp-fg-muted);
  }

  ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 13px;
    color: var(--nmp-fg);
    font-size: 15px;
    text-decoration: none;
    transition: background-color 150ms var(--nmp-ease);
  }

  a:hover {
    background: var(--nmp-hover);
  }

  svg {
    flex-shrink: 0;
    fill: none;
    stroke: var(--nmp-fg-dim);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
