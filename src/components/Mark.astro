      <path d="M511.3 545.51L497.75 555H476V495.1Z"></path>
      <path d="M556 192.28v261.44c-13.21-5.61-27.74-8.72-43-8.72-12.98 0-25.44 2.25-37 6.38V194.62c11.56 4.13 24.02 6.38 37 6.38 15.26 0 29.79-3.11 43-8.72Z"></path>
      <path d="M201.36 102.86l251.9 359.76c-24.46 15.85-42.23 41.16-48.13 70.74L157.35 179.49c24.09-17.82 40.65-45.25 44.01-76.63Z"></path>
