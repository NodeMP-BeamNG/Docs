// website/src/brand/mark.json): beams in the text colour, nodes in the accent,
// 50 units tall in a 64-unit box. Changes there change here.
const { size = 24, mono = false } = Astro.props as { size?: number; mono?: boolean };
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
