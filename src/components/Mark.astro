---
// The NodeMP mark as the site draws it (website/src/brand/Mark.tsx): beams in
// the text colour, nodes in the accent. Changes there change here.
const { size = 24, mono = false } = Astro.props as { size?: number; mono?: boolean };
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <path d="M14 50V14L50 50V14" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
  <g fill={mono ? 'currentColor' : 'var(--nmp-accent)'}>
    <circle cx="14" cy="14" r="7"></circle>
    <circle cx="14" cy="50" r="7"></circle>
    <circle cx="50" cy="14" r="7"></circle>
    <circle cx="50" cy="50" r="7"></circle>
  </g>
</svg>
