---
// The docs' bar: the site's floating bar (website/src/ui/Nav.tsx), folded into the
// corner Starlight keeps for its site title -- the mark (to nodemp.com), search and
// RU | EN, over the sidebar. The site's sections live in the phone menu's foot.
//
// The fold: this bar starts where the site's bar is, centred and wide, and slides and
// narrows into its corner with the mark in place, search and RU | EN coming in on the
// way. Only on a wide screen, and never under reduced motion.
//
// The site keeps its bar's box in window.name ("nmp-from-site:{x,y,w,h}"; the name
// survives a navigation between nodemp.com and its own subdomains), and this bar folds
// out of it however the docs are reached from the site. From the site's Docs link the
// fold has already begun there, on the click: the site's bar moves at once and trades
// its links for a pixel copy of this bar's items (website/src/ui/DocsLink.tsx,
// globals.css), and the box carries the moment it began (t); this bar picks the fold up
// from that moment, so it runs on unbroken however long the page took. A first docs page
// in a tab folds from the start; so does a page brought back from the cache.
//
// Leaving by any way -- the mark, Back, a link to the site -- this bar's resting box goes
// with the page ("nmp-from-docs:", in window.name from the start of the visit), and the
// site's bar opens out of this corner on arrival, its first frame a copy of this bar:
// the fold, run backwards (website/src/ui/Nav.tsx).
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import Mark from './Mark.astro';
import { inLocale } from '../lib/locale';

const { locale } = Astro.locals.starlightRoute;
const ru = locale === 'ru';
const site = `https://nodemp.com/${ru ? 'ru' : 'en'}`;
const langs = Object.entries(config.locales ?? {}).map(([code, l]) => ({
  short: code === 'root' ? 'EN' : code.toUpperCase(),
  name: l!.label,
  lang: l!.lang,
  href: inLocale(Astro.url.pathname, code === 'root' ? undefined : code),
  current: (code === 'root' ? undefined : code) === locale,
}));
const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<script is:inline>
  (() => {
    try {
      const root = document.documentElement;
      const wide = matchMedia('(min-width: 50rem)').matches;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const FOLD = 620;
      let hand = null;
      if (window.name.startsWith('nmp-from-site:')) {
        try { hand = JSON.parse(window.name.slice(14)); } catch {}
      }
      // Ours from another docs page, or the site's: either way read, so dropped.
      if (window.name.startsWith('nmp-from-site:') || window.name.startsWith('nmp-from-docs:')) window.name = '';
      if (hand) sessionStorage.setItem('nmp-site-bar', JSON.stringify(hand));
      const from = document.referrer ? new URL(document.referrer).host : '';
      const fromSite = from !== location.host && /(^|\.)nodemp\.com$/.test(from);
      const first = !sessionStorage.getItem('nmp-docs-entered');
      sessionStorage.setItem('nmp-docs-entered', '1');
      const stored = () => {
        try { return JSON.parse(sessionStorage.getItem('nmp-site-bar') || 'null'); } catch { return null; }
      };
      // This bar rests 0.75rem (12 px) in from the top and the left (header.header's padding).
      const fold = (b, at) => {
        if (b) {
          root.style.setProperty('--nmp-from-l', b.x - 12 + 'px');
          root.style.setProperty('--nmp-from-w', b.w + 'px');
          root.style.setProperty('--nmp-from-dy', b.y - 12 + 'px');
        }
        if (at === null) root.style.removeProperty('--nmp-fold-delay');
        else root.style.setProperty('--nmp-fold-delay', -at + 'ms');
        root.classList.add('nmp-entering');
      };
      const settle = () => setTimeout(() => root.classList.remove('nmp-entering', 'nmp-arriving'), FOLD + 480);
      if (!calm) {
        if (hand) {
          // With t the fold began on the site's click and is picked up from there; without
          // (Forward, a typed address) it starts here.
          root.classList.add('nmp-arriving');
          const at = hand.t ? Math.max(0, Date.now() - hand.t) : null;
          if (wide && (at === null || at < FOLD)) fold(hand, at);
        } else if (wide && first && !fromSite) {
          fold(stored(), null);
        }
        settle();
      }
      // This bar's resting box, left in window.name for the whole visit, so any way out
      // carries it. Written now, not on pagehide: for a page that can go into the
      // back-forward cache Chrome swaps the browsing context before pagehide, and a name
      // written then never reaches the next page.
      const rem = parseFloat(getComputedStyle(root).fontSize) || 16;
      window.name = 'nmp-from-docs:' + JSON.stringify({ x: 12, y: 12, w: Math.round(wide ? 17.75 * rem : innerWidth - 24), h: 52 });
      addEventListener('pageshow', (e) => {
        root.classList.remove('nmp-leaving');
        if (!e.persisted) return;
        window.name = 'nmp-from-docs:' + JSON.stringify({ x: 12, y: 12, w: Math.round(wide ? 17.75 * rem : innerWidth - 24), h: 52 });
        if (calm || !wide) return;
        root.classList.remove('nmp-entering', 'nmp-arriving');
        void root.offsetWidth;
        root.classList.add('nmp-arriving');
        fold(stored(), null);
        settle();
      });
      // The mark: the page dims while the site loads; the bar stays whole until the site's takes over.
      addEventListener('click', (e) => {
        const a = e.target instanceof Element ? e.target.closest('.nmp-home') : null;
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        root.classList.remove('nmp-entering', 'nmp-arriving');
        root.classList.add('nmp-leaving');
        setTimeout(() => root.classList.remove('nmp-leaving'), 5000);
      });
    } catch {}
  })();
</script>

<div class="nmp-bar">
  <a class="nmp-home" href={site} aria-label={ru ? 'NodeMP — на главную сайта' : 'NodeMP — the website'}>
    <Mark size={22} />
  </a>
  <div class="nmp-search">{shouldRenderSearch && <Search />}</div>
  <nav class="nmp-lang" aria-label={ru ? 'Язык' : 'Language'}>
    {langs.map((l) => (
      <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.name} aria-current={l.current ? 'true' : undefined}>
        {l.short}
      </a>
    ))}
  </nav>
</div>

<style>
  .nmp-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 52px;
    width: 100%;
    padding-inline: 8px 52px;
    border-radius: 18px;
    background: var(--nmp-nav-surface);
    box-shadow: inset 0 0 0 1px var(--nmp-hairline);
  }

  .nmp-home {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    height: 36px;
    padding-inline: 8px;
    border-radius: 13px;
    color: var(--nmp-fg);
    transition: background-color 200ms var(--nmp-ease);
  }

  .nmp-home:hover {
    background: var(--nmp-hover);
  }

  .nmp-search {
    flex: 1;
    min-width: 0;
  }

  /* No max-width: Starlight's 22rem would leave a gap before RU | EN while the bar is
     still wide in the fold, where the site's copy of these items fills the row. */
  .nmp-search :global(button[data-open-modal]) {
    width: 100%;
    max-width: none;
    height: 36px;
    border: 0;
    border-radius: 13px;
    background: var(--nmp-hover);
    color: var(--nmp-fg-muted);
    font-size: 14px;
    transition: background-color 200ms var(--nmp-ease);
  }

  .nmp-search :global(button[data-open-modal]:hover) {
    background: var(--nmp-hover-strong);
    color: var(--nmp-fg);
  }

  /* No room for the shortcut's chip in the folded bar; Ctrl+K and / still open search. */
  .nmp-search :global(kbd) {
    display: none;
  }

  /* A phone: Starlight drops the label, so search is a square magnifier by the menu. */
  @media (max-width: 49.99rem) {
    .nmp-search {
      display: flex;
      justify-content: flex-end;
    }

    .nmp-search :global(button[data-open-modal]) {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
  }

  .nmp-lang {
    display: none;
    flex-shrink: 0;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 13px;
    background: var(--nmp-hover);
  }

  .nmp-lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 28px;
    border-radius: 10px;
    color: var(--nmp-fg-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms var(--nmp-ease),
      color 200ms var(--nmp-ease);
  }

  .nmp-lang a:hover {
    color: var(--nmp-fg);
  }

  .nmp-lang a[aria-current] {
    background: var(--nmp-hover-strong);
    color: var(--nmp-fg);
  }

  /* A wide screen: the bar folds into the sidebar's corner. */
  @media (min-width: 50rem) {
    .nmp-bar {
      width: calc(var(--sl-sidebar-width) - 0.75rem);
      padding-inline-end: 8px;
    }

    .nmp-lang {
      display: inline-flex;
    }

    /* The fold, the one long move on the site: 620 ms, eased at both ends so the slide
       reads as a slide. The bar starts in the box the site handed over (--nmp-from-l /
       -w / -dy, set by the script above), or centred at the site's width when there was
       none, and narrows home with the mark where it was; search and RU | EN come in on
       the way. Picked up from the site, --nmp-fold-delay is negative: the time the fold
       has already run there. Otherwise it starts a beat late, so the first frame is the
       site's bar. Timing and steps match the site's bar-fold and ghost-in (globals.css),
       so the two meet on the same frame. */
    :global(.nmp-entering) .nmp-bar {
      animation: nmp-fold 620ms cubic-bezier(0.65, 0, 0.35, 1) var(--nmp-fold-delay, 80ms) both;
    }

    :global(.nmp-entering) .nmp-search,
    :global(.nmp-entering) .nmp-lang {
      animation: nmp-items-in 620ms linear var(--nmp-fold-delay, 80ms) both;
    }
  }

  @keyframes nmp-fold {
    from {
      translate: var(--nmp-from-l, calc((100vw - min(780px, 100vw - 1.5rem)) / 2 - 0.75rem)) var(--nmp-from-dy, 0px);
      width: var(--nmp-from-w, min(780px, 100vw - 1.5rem));
    }
  }

  @keyframes nmp-items-in {
    0%,
    10% {
      opacity: 0;
    }
    45%,
    100% {
      opacity: 1;
    }
  }
</style>
