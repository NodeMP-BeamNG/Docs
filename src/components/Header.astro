---
// The docs' bar: the site's floating bar (website/src/ui/Nav.tsx), folded into the
// corner Starlight keeps for its site title -- the mark (to nodemp.com), search and
// RU | EN, over the sidebar. The site's sections live in the phone menu's foot.
//
// Arriving from nodemp.com (or on the first docs page of a tab) this bar starts where
// the site's bar is, centred and wide, and folds to the left: it slides and narrows to
// its corner with the mark in place, search and RU | EN coming in on the way. Only on a
// wide screen, and never under reduced motion.
//
// The hand-off, both ways. The page being left dims to half and fades its bar down to
// the plate and the mark -- the one thing both bars have in the same spot -- and leaves
// the plate's box in window.name ("nmp-bar:{x,y,w,h}"; the name survives a navigation
// between nodemp.com and its own subdomains). The page arriving starts its bar at that
// box, moves it home and brings its own items in, while the page comes up from half.
// Here: a click on the mark hands this bar to the site (website/src/ui/Nav.tsx), whose
// bar then opens out of this corner -- this fold, run backwards.
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import Mark from './Mark.astro';
import { inLocale } from '../lib/locale';

const { locale } = Astro.locals.starlightRoute;
const ru = locale === 'ru';
const site = `https://nodemp.com/${ru ? 'ru' : 'en'}`;
const langs = Object.entries(config.locales ?? {}).map(([code, l]) => ({
  short: code === 'root' ? 'EN' : code.toUpperCase(),
  name: l!.label,
  lang: l!.lang,
  href: inLocale(Astro.url.pathname, code === 'root' ? undefined : code),
  current: (code === 'root' ? undefined : code) === locale,
}));
const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<script is:inline>
  (() => {
    try {
      const root = document.documentElement;
      const wide = matchMedia('(min-width: 50rem)').matches;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let bar = null;
      if (window.name.startsWith('nmp-bar:')) {
        try { bar = JSON.parse(window.name.slice(8)); } catch {}
        window.name = '';
      }
      const from = document.referrer ? new URL(document.referrer).host : '';
      const fromSite = from !== location.host && /(^|\.)nodemp\.com$/.test(from);
      const first = !sessionStorage.getItem('nmp-docs-entered');
      sessionStorage.setItem('nmp-docs-entered', '1');
      if (calm) return;
      if (bar) root.classList.add('nmp-arriving');
      if (wide && (bar || fromSite || first)) {
        // This bar rests 0.75rem (12 px) in from the top and the left (header.header's padding).
        if (bar) {
          root.style.setProperty('--nmp-from-l', bar.x - 12 + 'px');
          root.style.setProperty('--nmp-from-w', bar.w + 'px');
          root.style.setProperty('--nmp-from-dy', bar.y - 12 + 'px');
        }
        root.classList.add('nmp-entering');
      }
      setTimeout(() => root.classList.remove('nmp-entering', 'nmp-arriving'), 1100);
      // The way back: hand the plate to the site, which opens its bar out of this corner.
      addEventListener('click', (e) => {
        const a = e.target instanceof Element ? e.target.closest('.nmp-home') : null;
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const r = document.querySelector('.nmp-bar')?.getBoundingClientRect();
        if (r) window.name = 'nmp-bar:' + JSON.stringify({ x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.width), h: Math.round(r.height) });
        root.classList.remove('nmp-entering', 'nmp-arriving');
        root.classList.add('nmp-leaving');
        const undo = () => root.classList.remove('nmp-leaving');
        addEventListener('pageshow', undo, { once: true });
        setTimeout(undo, 5000);
      });
    } catch {}
  })();
</script>

<div class="nmp-bar">
  <a class="nmp-home" href={site} aria-label={ru ? 'NodeMP — на главную сайта' : 'NodeMP — the website'}>
    <Mark size={22} />
  </a>
  <div class="nmp-search">{shouldRenderSearch && <Search />}</div>
  <nav class="nmp-lang" aria-label={ru ? 'Язык' : 'Language'}>
    {langs.map((l) => (
      <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.name} aria-current={l.current ? 'true' : undefined}>
        {l.short}
      </a>
    ))}
  </nav>
</div>

<style>
  .nmp-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 52px;
    width: 100%;
    padding-inline: 8px 52px;
    border-radius: 18px;
    background: var(--nmp-nav-surface);
    box-shadow: inset 0 0 0 1px var(--nmp-hairline);
  }

  .nmp-home {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    height: 36px;
    padding-inline: 8px;
    border-radius: 13px;
    color: var(--nmp-fg);
    transition: background-color 200ms var(--nmp-ease);
  }

  .nmp-home:hover {
    background: var(--nmp-hover);
  }

  .nmp-search {
    flex: 1;
    min-width: 0;
  }

  .nmp-search :global(button[data-open-modal]) {
    width: 100%;
    height: 36px;
    border: 0;
    border-radius: 13px;
    background: var(--nmp-hover);
    color: var(--nmp-fg-muted);
    font-size: 14px;
    transition: background-color 200ms var(--nmp-ease);
  }

  .nmp-search :global(button[data-open-modal]:hover) {
    background: var(--nmp-hover-strong);
    color: var(--nmp-fg);
  }

  /* No room for the shortcut's chip in the folded bar; Ctrl+K and / still open search. */
  .nmp-search :global(kbd) {
    display: none;
  }

  /* A phone: Starlight drops the label, so search is a square magnifier by the menu. */
  @media (max-width: 49.99rem) {
    .nmp-search {
      display: flex;
      justify-content: flex-end;
    }

    .nmp-search :global(button[data-open-modal]) {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
  }

  .nmp-lang {
    display: none;
    flex-shrink: 0;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 13px;
    background: var(--nmp-hover);
  }

  .nmp-lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 28px;
    border-radius: 10px;
    color: var(--nmp-fg-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms var(--nmp-ease),
      color 200ms var(--nmp-ease);
  }

  .nmp-lang a:hover {
    color: var(--nmp-fg);
  }

  .nmp-lang a[aria-current] {
    background: var(--nmp-hover-strong);
    color: var(--nmp-fg);
  }

  /* A wide screen: the bar folds into the sidebar's corner. */
  @media (min-width: 50rem) {
    .nmp-bar {
      width: calc(var(--sl-sidebar-width) - 0.75rem);
      padding-inline-end: 8px;
    }

    .nmp-lang {
      display: inline-flex;
    }

    /* The fold, the one long move on the site: 620 ms, eased at both ends so the slide
       reads as a slide, a beat late so the first frame is the site's bar. The bar starts
       in the box the site handed over (--nmp-from-l / -w / -dy, set by the script above),
       or centred at the site's width when there was none, and narrows home with the mark
       where it was; search and RU | EN come in on the first half of the way. */
    :global(.nmp-entering) .nmp-bar {
      animation: nmp-fold 620ms cubic-bezier(0.65, 0, 0.35, 1) 80ms both;
    }

    :global(.nmp-entering) .nmp-search,
    :global(.nmp-entering) .nmp-lang {
      animation: nmp-items-in 620ms var(--nmp-ease) 80ms both;
    }
  }

  /* Leaving for the site: the bar fades to the plate and the mark, which the site's bar
     opens out of. */
  :global(.nmp-leaving) .nmp-search,
  :global(.nmp-leaving) .nmp-lang {
    opacity: 0;
    transition: opacity 160ms var(--nmp-ease);
  }

  @keyframes nmp-fold {
    from {
      translate: var(--nmp-from-l, calc((100vw - min(780px, 100vw - 1.5rem)) / 2 - 0.75rem)) var(--nmp-from-dy, 0px);
      width: var(--nmp-from-w, min(780px, 100vw - 1.5rem));
    }
  }

  @keyframes nmp-items-in {
    0%,
    10% {
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
  }
</style>
